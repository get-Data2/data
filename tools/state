#!/bin/sh
# 어디서든 상태 추정 명령 실행: state observe | labels | all ...
# 프로젝트 폴더로 이동해 .venv의 파이썬으로 실행한다.
# GPU 그룹(video·render)이 계정에는 있는데 이 프로세스에 아직 반영되지 않았으면(그룹 추가 전에 시작한 셸) sg로 다시 실행한다.
ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
export CUBLAS_WORKSPACE_CONFIG=:4096:8 PYTHONUNBUFFERED=1 PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
if [ -z "$STATE_SG" ] && ! id -nG | tr ' ' '\n' | grep -qx video && id -nG "$(id -un)" | tr ' ' '\n' | grep -qx video; then
  export STATE_SG=1
  q=""
  for a in "$0" "$@"; do q="$q '$(printf %s "$a" | sed "s/'/'\\\\''/g")'"; done
  exec sg video -c "sg render -c \"$q\""
fi
cd "$ROOT" && exec "$ROOT/.venv/bin/python" -m state "$@"
