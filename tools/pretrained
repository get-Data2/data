#!/bin/sh
# 어디서든 사전학습 모델 명령 실행: pretrained check | fetch | predict val | select | test | bench | report
# 프로젝트 폴더로 이동해 .venv의 파이썬으로 실행한다. fetch 외 명령은 HF_HUB_OFFLINE=1(받아 둔 리비전만 사용).
# GPU 그룹(video·render)이 계정에는 있는데 이 프로세스에 아직 반영되지 않았으면 sg로 다시 실행한다.
ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
export CUBLAS_WORKSPACE_CONFIG=:4096:8 PYTHONUNBUFFERED=1 PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export HF_HOME="$ROOT/var/pretrained/hf"
[ "$1" = "fetch" ] || export HF_HUB_OFFLINE=1
if [ -z "$PRETRAINED_SG" ] && ! id -nG | tr ' ' '\n' | grep -qx video && id -nG "$(id -un)" | tr ' ' '\n' | grep -qx video; then
  export PRETRAINED_SG=1
  q=""
  for a in "$0" "$@"; do q="$q '$(printf %s "$a" | sed "s/'/'\\\\''/g")'"; done
  exec sg video -c "sg render -c \"$q\""
fi
cd "$ROOT" && exec "$ROOT/.venv/bin/python" -m pretrained "$@"
