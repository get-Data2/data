# systemd 사용자 서비스 — deploy/install.sh가 @ROOT@를 프로젝트 경로로 바꿔 설치한다.
[Unit]
Description=team2 MQTT 센서 수집기 (과제 1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
Environment=PYTHONUNBUFFERED=1
# 잠금 파일로 cron 감시 스크립트와 동시에 돌지 않게 한다
ExecStart=/usr/bin/flock -n @ROOT@/var/collector.lock @ROOT@/.venv/bin/python -m collector run
# 주 프로세스는 flock이므로 HUP은 그 자식(파이썬 수집기)에게 보낸다. flock에 보내면 flock이 죽어 재시작된다(2026-10-20 실제 발생)
ExecReload=/usr/bin/pkill -HUP -P $MAINPID -f "collector run"
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=5
MemoryMax=256M

[Install]
WantedBy=default.target
