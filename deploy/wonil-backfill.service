# InfluxDB 과거 데이터 적재 — wonil-backfill.timer가 10분마다 띄운다. deploy/install-backfill.sh가 @ROOT@를 바꿔 설치.
# InfluxDB 망이 끊겨 있으면 실패(종료 코드 3)하고 다음 타이머에 다시 시도한다. 다 끝나면 var/backfill_done이 생겨 더 돌지 않는다.
[Unit]
Description=wonil InfluxDB 과거 데이터 적재 (과제 1 US6)
ConditionPathExists=!@ROOT@/var/backfill_done

[Service]
Type=oneshot
WorkingDirectory=@ROOT@
Environment=PYTHONUNBUFFERED=1
ExecStart=@ROOT@/.venv/bin/python -m collector backfill
Nice=10
MemoryMax=512M
